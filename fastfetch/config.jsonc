{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
    	"type": "auto",
    	"source": "$XDG_CONFIG_HOME/fastfetch/logo.txt",
	"color": {
	    "1": "bright_blue"
	}
    },

    "display": {
        "separator": "  ",          
        "color": {
            "keys": "bright_blue",          
	    "title": "default",
	    "separator": "default"
	},
        "key": {
            "width": 14,           
            "alignment": "left"
        },
        "percent": {
            "type": 9,           
            "green": 50,          
            "yellow": 80,          
	    "red": 80              
        }
    },

    "modules": [
        {
            "type": "title",
            "key": " ",
            "separator": "",
            "format": "\u001b[95mhello, {user-name}!\u001b[0m",
            "color": "default"
        },
        "break",
        {
            "type": "custom",
            "key": "\u001b[94m┌─ \u001b[96mSystem Information\u001b[94m ───────────────────────────────────┐\u001b[0m",
	    "format": "",
            "separator": ""
        },
        {
            "type": "title",
            "key": "│  User",
            "keyColor": "bright_blue",
	    "color": "default"
        },
        { "type": "os",      "key": "│  OS",       "keyColor": "bright_blue" },
        { "type": "host",    "key": "│  Host",     "keyColor": "bright_blue" },
        { "type": "kernel",  "key": "│ 󰒓 Kernel",   "keyColor": "bright_blue" },
        { "type": "uptime",  "key": "│ 󰅐 Uptime",   "keyColor": "bright_blue" },
        { "type": "cpu",     "key": "│ 󰘚 CPU",      "keyColor": "bright_blue" },
        { "type": "memory",  "key": "│ 󰍛 Memory",   "keyColor": "bright_blue" },
        {
            "type": "disk",
            "key": "│ 󰋊 Disk",
            "keyColor": "bright_blue",
            "showRegular": true,
            "showHidden": false
        },
        {
            "type": "localip",
            "key": "│ 󰇄 IPv4",
            "keyColor": "bright_blue",
            "ipv4": true,
            "ipv6": false
        },
        {
            "type": "localip",
            "key": "│ 󰇄 IPv6",
            "keyColor": "bright_blue",
            "ipv4": false,
            "ipv6": true
        },
        {
		"type": "shell",   "key": "│ 󰆍 Shell",    "keyColor": "bright_blue"
	},
        {
            "type": "custom",
            "key": "\u001b[94m└────────────────────────────────────────────────────────┘\u001b[0m",
            "format": "",
	    "separator": ""
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}

